APP_NAME="MCP Inspector"
APP_ID=com.venusian.mcp-inspector
APP_MEMORY_LIMIT=256M
APP_ENV=local
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

IO_POOLS_WAITER_BACKEND=kqueue
WORKFLOWS_RUNTIME=loop

SKETCH_REFRESH_RATE=60
TOOLKIT_BRIDGE=appkit

PSS_MCP_URL=https://projectsaturnstudios.com/mcp/operator
PSS_MCP_TOKEN=
