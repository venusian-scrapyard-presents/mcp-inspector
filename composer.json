{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "venusian-scrapyard-presents/mcp-inspector",
    "type": "project",
    "description": "Venusian framework-powered desktop inspector for Model Context Protocol servers.",
    "keywords": [
        "venusian",
        "mcp",
        "inspector"
    ],
    "version": "0.10.0",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "venusian/surface": "^0.10.5",
        "venusian/framework": "^0.10.0",
        "jovian/venusian-appkit": "^0.10.5",
        "superconductor/mcp": "^0.10.0",
        "semiconductor/stdio": "^0.10.0",
        "semiconductor/sse": "^0.10.0"
    },
    "suggest": {
        "php-io-extensions/kqueue": "(0.10.0) - exposes ext-kqueue for native event-loop events on macOS",
        "php-io-extensions/epoll": "(0.10.0) - exposes ext-epoll for native event-loop events on Linux",
        "jovian/venusian-gtk": "(0.10.0) - GTK-driven Windows, in place of jovian/venusian-appkit on Linux",
        "jovian/venusian-qt": "(0.10.0) - Qt-driven Windows, in place of jovian/venusian-appkit on Linux"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../superconductor-mcp/mcp"
        },
        {
            "type": "path",
            "url": "../../superconductor-mcp/stdio"
        },
        {
            "type": "path",
            "url": "../../superconductor-mcp/sse"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@post-root-package-install",
            "@post-create-project-cmd"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Voyager\\Core\\ComposerScripts::postAutoloadDump",
            "@php computer package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"file_put_contents('.env', preg_replace('/^APP_KEY=(?=\\R)/m', 'APP_KEY=base64:'.base64_encode(random_bytes(32)), file_get_contents('.env')));\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
